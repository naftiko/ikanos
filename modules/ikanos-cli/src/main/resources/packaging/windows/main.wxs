<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom override of jpackage's default main.wxs.

  WHY THIS FILE EXISTS: jpackage's built-in main.wxs only supports variable
  overrides via overrides.wxi (see that file's comment for why Fragment
  elements cannot live there). To add the PATH-injection Environment
  component, this file adds one new ComponentGroup as a direct child of
  Product (a valid position per the WiX v3 schema; ComponentGroup's
  allowed parents are Fragment and Product) and references it from the
  existing "DefaultFeature" Feature.

  IMPORTANT: this content was extracted directly from the ACTUAL jpackage
  bundled in this project's CI toolchain (via jpackage's "temp" option, then
  reading temp/config/main.wxs), NOT copied from a GitHub branch. An
  earlier attempt copied this file from openjdk/jdk21u on GitHub and it
  referenced a "wixhelper.dll" CustomAction DLL (JpCaDll/FindRelatedProductsEx)
  that does not exist in this project's actual jpackage output; GitHub's
  jdk21u branch is a moving target that does not correspond 1:1 to any given
  Temurin 21.0.x GA build. Copying it caused LGHT0103 "the system cannot find
  the file 'wixhelper.dll'". Lesson: always extract this file from the real
  jpackage in use (see instructions below), never from a GitHub branch/tag
  guess.

  Note: XML comments cannot contain two adjacent hyphens anywhere in their
  body (not just the closing marker) - this exact rule bit this same file
  once already when a command-line flag written as a double hyphen broke the
  comment parser. Avoid double hyphens in this comment block entirely.

  Per jpackage docs ("If you override a file, your custom file must contain
  all of the properties that the default contains"), this must stay a
  complete replacement; do not delete any of the original structure below,
  only the two additions marked "PATH INJECTION" have been added.

  IMPORTANT: this file is version-sensitive. If a JDK upgrade changes
  jpackage's bundled main.wxs, this file will silently drift out of sync
  since jpackage keeps using this override without any diff warning.
  Re-extract it after any JDK version bump: run jpackage for the msi type
  with the "temp" option pointed at an empty directory, then read the
  generated main.wxs under that directory's config subfolder.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <Product
    Id="$(var.JpProductCode)"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <!-- ===== PATH INJECTION: start ===== -->
    <!--
      Adds the ikanos launcher's install directory (INSTALLDIR, generated by
      jpackage's Files ComponentGroup) to the machine-wide PATH, so
      `ikanos serve capability.yaml` works from any NEW terminal immediately
      after running the MSI (existing terminals keep their stale PATH snapshot
      - this is normal Windows behavior for any installer, not a bug here).
    -->
    <ComponentGroup Id="JpAddToPathGroup" Directory="INSTALLDIR">
      <Component Id="JpAddToPathComponent" Guid="*">
        <Environment Id="JpPathEnv"
                     Name="PATH"
                     Value="[INSTALLDIR]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
        <!-- No-op registry key keyed to this component so Windows Installer
             has something to track for install/uninstall/repair bookkeeping. -->
        <RegistryValue Root="HKLM"
                        Key="Software\ikanos"
                        Name="PathEntryInstalled"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <!-- ===== PATH INJECTION: end ===== -->

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
      <!-- PATH INJECTION -->
      <ComponentGroupRef Id="JpAddToPathGroup"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <UIRef Id="JpUI"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="FindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="FindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <RemoveExistingProducts Before="CostInitialize"/>
    </InstallExecuteSequence>

  </Product>
</Wix>
