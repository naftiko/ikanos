        "textMode": "auto"
      },
      "title": "Error Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(ikanos_request_errors[$__rate_interval])) / clamp_min(sum(rate(ikanos_request_total[$__rate_interval])), 1)",
          "legendFormat": "error %"
        }
      ]
    },
