    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 104,
      "title": "JVM Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Recent CPU use of the Ikanos process, in % of one core, against the cores the JVM can use.",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "id": 40,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_cpu_recent_utilization * 100", "legendFormat": "ikanos process", "refId": "A" },
        { "expr": "jvm_cpu_count * 100", "legendFormat": "available", "refId": "B" }
      ],
      "title": "CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Java heap: what is used, what the JVM reserved, and its maximum (-Xmx, or a share of the container memory).",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "id": 41,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(jvm_memory_used{jvm_memory_type=\"heap\"})", "legendFormat": "used", "refId": "A" },
        { "expr": "sum(jvm_memory_committed{jvm_memory_type=\"heap\"})", "legendFormat": "committed", "refId": "B" },
        { "expr": "sum(jvm_memory_limit{jvm_memory_type=\"heap\"})", "legendFormat": "max", "refId": "C" }
      ],
      "title": "Heap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Metaspace, compiled code and class space: memory outside the heap, which also counts against the container limit.",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "id": 42,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (jvm_memory_pool_name) (jvm_memory_used{jvm_memory_type=\"non_heap\"})", "legendFormat": "{{ jvm_memory_pool_name }}", "refId": "A" }
      ],
      "title": "Non-heap memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Share of time spent in garbage collection, by collector.",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "id": 43,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (jvm_gc_name) (rate(jvm_gc_duration_sum[$__rate_interval]))", "legendFormat": "{{ jvm_gc_name }}", "refId": "A" }
      ],
      "title": "Garbage collection",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Live JVM threads.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "id": 44,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(jvm_thread_count)", "legendFormat": "threads", "refId": "A" }
      ],
      "title": "Threads",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Classes currently loaded.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "id": 45,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_class_count", "legendFormat": "loaded", "refId": "A" }
      ],
      "title": "Classes loaded",
      "type": "timeseries"
    }
